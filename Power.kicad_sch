				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "00cb1236-1ccb-4560-a4a2-584a38841114")
	)
	(text_box "SYSOFF contols Q2 (battery FET), however if Q1 is active the output will be active.\nThe battery charging is only active if Q1 is active.\nEN1=EN2=Hi disables Q1 and thus no charging."
		(exclude_from_sim no)
		(at 15.24 132.08 0)
		(size 104.14 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24f1df0f-87d7-4a76-9ab1-d26c65707386")
	)
	(text_box "QOD: Floating (Slow discharge)\nON: Default state is \"ON\" (WEAK-HIGH), given DIGITAL supply is active. For low power applications use internal MCU pull-down resistors, instead of GPIO state. State is lost in sleep-modes, but pull-up/down settings are retained."
		(exclude_from_sim no)
		(at 191.135 47.625 0)
		(size 75.565 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "35b40312-f2f4-466c-8d50-55c59a45d0b6")
	)
	(text_box "SW=ON:\nSelect V_{BAT} or V_{USB} (priority) for system VCC. Charging remains active, charging is controlled by MCU (default: USB100). DVCC_{EN}=Hi, activates main system. AVCC_{EN}=Hi (pull-up) when DVCC is active. AVCC can be disabled using load switch."
		(exclude_from_sim no)
		(at 15.24 156.845 0)
		(size 104.14 9.525)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "365aadff-ff26-4f1f-8b60-348d683d0f0b")
	)
	(text_box "CHR_EN\n-------\nEN1=0, EN2=0 : 100mA\nEN1=1, EN2=0 : 500mA\nEN1=0, EN2=1 : FAST CHARGE (SEE ILIM)\nEN1=1, EN2=1 : STANDBY/SUSPEND"
		(exclude_from_sim no)
		(at 162.56 121.92 0)
		(size 52.07 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6d7032ef-d71e-4a02-b17f-4e5ff7d4e309")
	)
	(text_box "SW=CHARGE ONLY\nExpect both V_{USB} and V_{BAT} to be present. ~{CE}=0, charging is set active. EN2=Hi sets BQ to fast charge (see ILIM)."
		(exclude_from_sim no)
		(at 15.24 149.225 0)
		(size 104.14 7.62)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7b000ed9-4eaf-4faf-8c1c-57c3987f3147")
	)
	(text_box "DESIGN CALCULATIONS\n------------\nDesign was done based on already available resistors (1k, 100k).\nTMR should be designed so that a battery can be completely charged up in the givien time.\n\nFAST CHARGE CURRENT (ISET):\nR_{ISET} = K_{ISET} / I_{CHG}\nK_{ISET} = 890 A Ohm # from datasheet\nI_{CHR} = 0.89 A\n\nINPUT CURRENT LIMIT (ILIM):\nR_{ILIM} = K_{ILIM} / I_{MAX}\nK_{ILIM} = 1550 A Ohm # from datasheet\nI_{MAX} = 1.18 A\n\nFAST-CHARGE SAFETY TIMER (TMR):\nR_{TMR} = t_{MAXCHG} / (10 x K_{TMR})\nK_{TMR} = 48 s/kOhm # from datasheet\nt_{MAXCHG} = 6.7 hr x 3600 s/hr\n\nCHARGE CURRENT TRANSLATION:\nV_{ISET} = I_{CHR} / 200 x R_{ISET}"
		(exclude_from_sim no)
		(at 121.285 105.41 0)
		(size 39.37 57.785)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7f135a96-cd85-4cba-9e64-81794bfe224a")
	)
	(text_box "Note: See \"Sparkfun Battery Babysitter\" for some good implementation notes."
		(exclude_from_sim no)
		(at 186.69 93.98 0)
		(size 27.94 8.89)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8224ca0c-c32f-482b-8e0e-69c934aca657")
	)
	(text_box "POS 3 (4/8) : SYSTEM ON\nPOS 2 (2/6) : CHARGE ONLY\nPOS 1 (1/5) : SYSTEM OFF\nSP3T could work too, late system change. Used CL-SB-23A for availability."
		(exclude_from_sim no)
		(at 75.184 120.015 0)
		(size 44.196 12.065)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
