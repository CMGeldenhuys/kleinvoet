			)
			(justify left top)
		)
		(uuid "9cbbc0b4-6476-466b-b9a0-289764f3306e")
	)
	(text_box "SW=OFF\nSYSOFF=Low (active), this connects V_{BAT} to the output. Charging is disabled (~{CE}=1, and Q1 off).\nEN1=EN2=Low (USB100), if USB is present V_{USB} is connected to output with a 100mA current limit.\nRegardless of source, rest of system remains powered down (DVCC_{EN}=Low)."
		(exclude_from_sim no)
		(at 15.24 139.7 0)
		(size 104.14 9.525)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9e7a3533-399d-432d-b288-595190d656b7")
	)
	(text_box "C_{T} Calculations: [See Datasheet]\n----------------\nR_{L} = 180 Ohm (~20mA load)\nC_{L} = 1u + 10u + 2 * (10u+10u+10u) = 71uF\nI_{RUSH} = 150ma\n\nSlew Rate = I_{RUSH} / C_{L} = 2.11 mv/us\nSR_{ON} = 1900 [From datasheet]\nC_{T}_{MIN} = SR_{ON} / SR = 900pF\n\nChoose C_{T} = 2700pF (2.7nF)\nSlew Rate = SR_{ON} / C_{T} =  0.70 mV/us\nI_{RUSH} = SR * C_{L} = 50mA"
		(exclude_from_sim no)
		(at 191.135 59.055 0)
		(size 52.705 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a16a2907-91a3-478d-a567-060d79275841")
	)
	(text_box "NOTE: Internal pull-ups are ~285kOhm, beware of voltage devider that can form with 100k"
		(exclude_from_sim no)
		(at 162.56 149.225 0)
		(size 52.07 5.08)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c429bd03-4e8f-4bad-8914-b15398a594e2")
	)
	(text_box "SYMBOLS\n----------\nILIM - Input current limit to device (incl. LIPO charging and system load)\nISET - Fast charging current limit\nTMR - Safety timer to prevent battery damage\n~{PGOOD} - Status indicator of good power from USB\n~{CHR} - Status indicator for charging\n~{CE} - Enable/Disable charging"
		(exclude_from_sim no)
		(at 162.56 102.87 0)
		(size 52.07 19.05)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "de0b1729-6a30-489c-95e0-5b1804795968")
	)
	(text_box "Power Rails\n----------------------------\nVBUS - USB bus power (5V) [Max 500mA]\n+BATT - LIPO power (3.6-4.2V) [Max 1A]\nVCC - VBUS (pref.) or +BATT [Max 500mA]\nVDD - GPS backup battery\n+3v3 - Main 3.3V supply [Max 500mA]\n+3.3VADC - 3.3V rail for ADC with filtering [Max 25mA]\n+3.3VA - 3.3V rail for analogue part of MCU [Max 25mA]"
		(exclude_from_sim no)
		(at 121.92 16.51 0)
		(size 60.96 22.86)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
