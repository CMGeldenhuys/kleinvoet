		(uuid "9a5604bf-8a5e-4968-bf93-65a1bf35cfe3")
	)
	(text_box "BATT+ lies outside the ADC range of the STM32 MCU (> 3.3V)"
		(exclude_from_sim no)
		(at 120.65 189.865 0)
		(size 55.245 5.715)
		(margins 0.9525 0.9525 0.9525 0.9525)
