			)
			(justify left top)
		)
		(uuid "82f56c85-8f6c-494b-b15e-4f132be9e76d")
	)
	(text_box "Alternative Parts:\nTPS7A20: Cheaper, Higher IQ, Same noise figure"
		(exclude_from_sim no)
		(at 215.9 125.73 0)
		(size 67.31 5.715)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
