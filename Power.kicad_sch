				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8ed9d27c-f522-440d-b082-03297c811e84")
	)
	(text_box "CHG (On): Charging or suspend from temperature\nCHG (FLASH, 2s): Safety timer expired\nCHG (Off): Not charging, done, battery missing, no vbus"
		(exclude_from_sim no)
		(at 87.376 183.388 0)
		(size 32.766 13.462)
		(margins 0.9525 0.9525 0.9525 0.9525)
