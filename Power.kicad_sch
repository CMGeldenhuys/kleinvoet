		)
		(uuid "83992ccd-58f8-4bf3-b90b-b29551750478")
	)
	(text_box "~{CHG} STATUS INDICATOR\n------\nLED ON : CHARGING\nLED FLASH (2Hz) : SAFETY TIMER ACTIVE\nLED OFF : DONE/NO BATT"
		(exclude_from_sim no)
		(at 162.56 137.16 0)
		(size 52.07 12.065)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
